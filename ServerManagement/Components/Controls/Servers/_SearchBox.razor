<h3>SearchBox</h3>
<br />
<div class="row w-75">
    <div class="col-5">
        <input type="" style="width:200px" class="form-control" @bind-value="searchSever" />
    </div>
    <div class="col-2">
        <button type="button" class="btn btn-primary" @onclick="SeverSearchChange">Search</button>
    </div>
</div>
<br />
@code {
    [Parameter]
    public string searchSever { get; set; }
    [Parameter]
    public EventCallback<string> OnSeverFilter { get; set; }
    private async Task SeverSearchChange()
    {
        await OnSeverFilter.InvokeAsync(searchSever);
    }
}
